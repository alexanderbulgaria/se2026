{% extends 'base.html.twig' %}

{% block title %}Достъпът е отказан{% endblock %}

{% block body %}
<div class="container">
  <div class="card">
    <h1 style="margin-top: 0;">Достъпът е отказан (403)</h1>

    <p>Нямате права за достъп до тази страница.</p>

    <p style="margin-top: 16px;">
      <a href="{{ path('app_home') }}">Към началото</a>
      {% if app.user %}
        | <a href="{{ path('app_profile') }}">Към профила</a>
      {% else %}
        | <a href="{{ path('app_login') }}">Вход</a>
      {% endif %}
    </p>
  </div>
</div>
{% endblock %}
