{% extends 'base.html.twig' %}

{% block title %}Post index{% endblock %}

{% block body %}
    <h1>Списък с публикации</h1>

    <table class="table">
        <thead>
            <tr>
				<th>ID</th>
				<th>Заглавие</th>
				<th>Съдържание</th>
				<th>Създадена на</th>
				<th>Действия</th>
            </tr>
        </thead>
        <tbody>
        {% for post in posts %}
            <tr>
                <td>{{ post.id }}</td>
                <td>{{ post.title }}</td>
                <td>{{ post.content }}</td>
                <td>{{ post.createdAt|date('d.m.Y H:i') }}</td>
                <td>
                    <a href="{{ path('app_post_show', {'id': post.id}) }}">преглед</a>
                    <a href="{{ path('app_post_edit', {'id': post.id}) }}">редакция</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_post_new') }}">Нова публикация</a>
{% endblock %}
